{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Azure AKS architecture template for running Open edX with Tutor Kubernetes."
  },
  "parameters": {
    "clusterName": {
      "type": "string",
      "defaultValue": "openedxaks",
      "minLength": 3,
      "maxLength": 18,
      "metadata": {
        "description": "Short lowercase name used for Azure resources. Use letters and numbers only."
      }
    },
    "dnsPrefix": {
      "type": "string",
      "defaultValue": "[concat('openedxaks', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "AKS control-plane DNS prefix."
      }
    },
    "nodeVmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v5",
      "metadata": {
        "description": "AKS node VM size. Use at least 4 GB RAM per node for Tutor Kubernetes."
      }
    },
    "nodeCount": {
      "type": "int",
      "defaultValue": 3,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Initial AKS node count."
      }
    },
    "minNodeCount": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Minimum AKS autoscaler node count."
      }
    },
    "maxNodeCount": {
      "type": "int",
      "defaultValue": 6,
      "minValue": 1,
      "maxValue": 20,
      "metadata": {
        "description": "Maximum AKS autoscaler node count."
      }
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 128,
      "minValue": 64,
      "metadata": {
        "description": "OS disk size in GB for each AKS node."
      }
    },
    "acrSku": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Basic",
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "Azure Container Registry SKU for Tutor-built images."
      }
    },
    "logRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Log Analytics retention in days."
      }
    }
  },
  "variables": {
    "location": "[resourceGroup().location]",
    "aksName": "[concat(parameters('clusterName'), '-aks')]",
    "identityName": "[concat(parameters('clusterName'), '-aks-id')]",
    "workspaceName": "[concat(parameters('clusterName'), '-logs')]",
    "acrName": "[toLower(concat(take(replace(parameters('clusterName'), '-', ''), 24), uniqueString(resourceGroup().id)))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[variables('location')]"
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('workspaceName')]",
      "location": "[variables('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[parameters('logRetentionDays')]"
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-11-01-preview",
      "name": "[variables('acrName')]",
      "location": "[variables('location')]",
      "sku": {
        "name": "[parameters('acrSku')]"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2024-05-01",
      "name": "[variables('aksName')]",
      "location": "[variables('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ],
      "properties": {
        "dnsPrefix": "[parameters('dnsPrefix')]",
        "enableRBAC": true,
        "agentPoolProfiles": [
          {
            "name": "systempool",
            "count": "[parameters('nodeCount')]",
            "vmSize": "[parameters('nodeVmSize')]",
            "osDiskSizeGB": "[parameters('osDiskSizeGB')]",
            "osType": "Linux",
            "mode": "System",
            "type": "VirtualMachineScaleSets",
            "enableAutoScaling": true,
            "minCount": "[parameters('minNodeCount')]",
            "maxCount": "[parameters('maxNodeCount')]"
          }
        ],
        "networkProfile": {
          "networkPlugin": "kubenet",
          "loadBalancerSku": "standard",
          "outboundType": "loadBalancer",
          "serviceCidr": "10.0.0.0/16",
          "dnsServiceIP": "10.0.0.10",
          "podCidr": "10.244.0.0/16"
        },
        "addonProfiles": {
          "omsagent": {
            "enabled": true,
            "config": {
              "logAnalyticsWorkspaceResourceID": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "aksName": {
      "type": "string",
      "value": "[variables('aksName')]"
    },
    "acrName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "getCredentialsCommand": {
      "type": "string",
      "value": "[concat('az aks get-credentials --resource-group ', resourceGroup().name, ' --name ', variables('aksName'), ' --overwrite-existing')]"
    },
    "tutorPrepareCommand": {
      "type": "string",
      "value": "[concat('RESOURCE_GROUP=', resourceGroup().name, ' AKS_NAME=', variables('aksName'), ' LMS_HOST=<lms-domain> CMS_HOST=<studio-domain> CONTACT_EMAIL=<email> MODE=prepare ./util/install/install-tutor-k8s-aks.sh')]"
    },
    "attachAcrCommand": {
      "type": "string",
      "value": "[concat('az aks update --resource-group ', resourceGroup().name, ' --name ', variables('aksName'), ' --attach-acr ', variables('acrName'))]"
    }
  }
}
